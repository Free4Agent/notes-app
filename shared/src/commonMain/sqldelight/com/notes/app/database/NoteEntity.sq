CREATE TABLE note (
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    modified_at INTEGER NOT NULL,
    tags TEXT NOT NULL DEFAULT '',
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_status TEXT NOT NULL DEFAULT 'PENDING_UPLOAD',
    remote_path TEXT
);

CREATE INDEX note_modified ON note(modified_at DESC);
CREATE INDEX note_sync ON note(sync_status);

CREATE TABLE todo (
    id TEXT PRIMARY KEY,
    content TEXT NOT NULL,
    is_completed INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    completed_at INTEGER,
    due_date INTEGER,
    recurrence_type TEXT,
    recurrence_interval INTEGER,
    note_id TEXT,
    priority TEXT DEFAULT 'NONE'
);

CREATE INDEX todo_note ON todo(note_id);
CREATE INDEX todo_due ON todo(due_date);

-- Note queries
getAllNotes:
SELECT * FROM note WHERE is_deleted = 0 ORDER BY modified_at DESC;

getNoteById:
SELECT * FROM note WHERE id = ? AND is_deleted = 0;

getNotesByStatus:
SELECT * FROM note WHERE sync_status = ? AND is_deleted = 0;

searchNotes:
SELECT * FROM note 
WHERE is_deleted = 0 
AND (title LIKE '%' || ? || '%' OR content LIKE '%' || ? || '%')
ORDER BY modified_at DESC;

getNotesByTag:
SELECT * FROM note 
WHERE is_deleted = 0 AND tags LIKE '%' || ? || '%'
ORDER BY modified_at DESC;

insertNote:
INSERT INTO note (id, title, content, created_at, modified_at, tags, sync_status)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateNote:
UPDATE note SET
    title = ?,
    content = ?,
    modified_at = ?,
    tags = ?,
    sync_status = ?
WHERE id = ?;

updateSyncStatus:
UPDATE note SET sync_status = ? WHERE id = ?;

softDeleteNote:
UPDATE note SET is_deleted = 1, sync_status = 'PENDING_UPLOAD' WHERE id = ?;

deleteNotePermanently:
DELETE FROM note WHERE id = ?;

-- Todo queries
getAllTodos:
SELECT * FROM todo ORDER BY 
    is_completed ASC,
    CASE WHEN due_date IS NULL THEN 1 ELSE 0 END,
    due_date ASC;

getTodosByNote:
SELECT * FROM todo WHERE note_id = ? ORDER BY is_completed, due_date;

getPendingTodos:
SELECT * FROM todo WHERE is_completed = 0 ORDER BY due_date;

getOverdueTodos:
SELECT * FROM todo 
WHERE is_completed = 0 
AND due_date IS NOT NULL 
AND due_date < ?;

insertTodo:
INSERT INTO todo (id, content, is_completed, created_at, completed_at, due_date, note_id, priority)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateTodo:
UPDATE todo SET
    content = ?,
    is_completed = ?,
    completed_at = ?,
    due_date = ?,
    priority = ?
WHERE id = ?;

deleteTodo:
DELETE FROM todo WHERE id = ?;

deleteTodosByNote:
DELETE FROM todo WHERE note_id = ?;